
from datetime import datetime
import os  # Biblioteca usada para interagir com o sistema operacional (ex: limpar terminal)
from sqlalchemy import create_engine, text  # Usado para criar a conexão e formatar queries SQL de forma segura
import funcoes  # Módulo personalizado contendo funções auxiliares (ex: mostrar_linha)
import pandas as pd  # Usado para manipular e visualizar os dados em formato de DataFrame
import pymysql.cursors  # Driver de conexão para bancos MySQL

# Cria a conexão padrão via PyMySQL (caso use em funções externas)
con = funcoes.obter_conexao()
cur = con.cursor()

# Configura o motor de conexão do SQLAlchemy para o banco "ferragens_do_ze"
engine = create_engine(
    "mysql+pymysql://admin:senaiead@172.16.22.76/ferragens_do_ze"
)


# FUNÇÃO: Limpa o terminal para melhorar a experiência visual do usuário
def limpar_tela():
    # 'cls' é usado no Windows (nt), 'clear' é usado no Linux/Mac
    os.system("cls" if os.name == "nt" else "clear")


# FUNÇÃO: Sincroniza os dados da memória com o banco de dados
def atualizar_estoque_memoria():
    global estoque, ids_validos  # Define as variáveis como globais para serem acessadas em todo o script
    # Lê a tabela do banco de dados e joga em um DataFrame do Pandas
    estoque = pd.read_sql_query("SELECT * FROM Produtos", engine)
    # Cria uma lista com todos os IDs existentes para validações rápidas
    ids_validos = estoque["Id"].tolist()


# Inicialização dos dados na primeira execução do script
atualizar_estoque_memoria()


# FUNÇÃO: Exibe o menu principal no console
def menu():
    limpar_tela()
    print(f"""
        {funcoes.mostrar_linha()}
        Ferragens do Zé - Controle de Estoque
        {funcoes.mostrar_linha()}
        [1] para adicionar item no estoque
        [2] para remover item do estoque
        [3] para adicionar um novo item no estoque
        [4] para sair do programa
        {funcoes.mostrar_linha()}
    """)


# Renderiza o menu inicial antes de entrar no laço de repetição
menu()

# Loop principal da aplicação
while True:
    pag1 = input("Selecione a opção desejada: ")

    # Validação para garantir que o usuário digitou um número inteiro
    try:
        pag1 = int(pag1)
    except ValueError:
        print("Opção inválida! Digite um número.")
        continue

    # ----------------------------------------
    # OPÇÃO 1: ADICIONAR QUANTIDADE AO ESTOQUE EXISTENTE
    # ----------------------------------------
    if pag1 == 1:
        while True:
            limpar_tela()
            print(f"--- ADICIONAR AO ESTOQUE ---\n")
            # Exibe o estoque atual sem os índices numéricos do Pandas
            print(estoque.to_string(index=False))
            print(f"\n{funcoes.mostrar_linha()}")

            id_add = input(
                "Selecione o Id do item ou -1 para retornar ao menu: "
            )

            # Garante que o ID digitado é um número inteiro
            try:
                id_add = int(id_add)
            except ValueError:
                input("ID inválido! Pressione Enter para tentar novamente...")
                continue

            # Se o usuário digitar -1, recarrega o menu principal e sai deste loop
            if id_add == -1:
                menu()
                break

            # Verifica se o ID informado realmente existe no banco de dados
            if id_add not in ids_validos:
                print(f"ID {id_add} não encontrado no estoque.")
                input("Pressione Enter para tentar novamente...")
                continue

            # Localiza e armazena o nome do produto selecionado pelo ID
            nome_produto = estoque.loc[estoque["Id"] == id_add, "Nome"].values[0]

            # Sub-loop para capturar e validar a quantidade a ser adicionada
            while True:
                print(f"\n-> Produto Selecionado: {nome_produto}")
                add = input(
                    "Digite a quantidade a ser adicionada ou -1 para retornar: "
                )
                try:
                    add = int(add)
                except ValueError:
                    print("Por favor, digite um número válido.")
                    continue

                if add == -1:
                    break

                # Impede a entrada de valores negativos ou zerados
                if add <= 0:
                    print("A quantidade deve ser maior que zero!")
                    continue

                # Descobre a quantidade atual em estoque e soma com a nova quantidade
                qtd_atual = estoque.loc[estoque["Id"] == id_add, "Quantidade"].values[0]
                nova_qtd = qtd_atual + add

                # Prepara a Query SQL utilizando Named Parameters (:parametro) contra SQL Injection
                sql = text(
                    "UPDATE Produtos SET Quantidade = :nova_qtd WHERE Id = :id_add"
                )
                valores = {"nova_qtd": nova_qtd, "id_add": id_add}

                # Executa a transação no banco de dados e commita automaticamente com o gerenciador de contexto (with)
                with engine.begin() as conexao:
                    conexao.execute(sql, valores)

                # Atualiza o DataFrame em memória com os novos dados salvos
                atualizar_estoque_memoria()

                print(f"\nSucesso! {add} unidades adicionadas a '{nome_produto}'.")
                input("Pressione Enter para continuar...")
                break

    # ----------------------------------------
    # OPÇÃO 2: REMOVER QUANTIDADE DO ESTOQUE
    # ----------------------------------------
    elif pag1 == 2:
        while True:
            limpar_tela()
            print(f"--- REMOVER DO ESTOQUE ---\n")
            print(estoque.to_string(index=False))
            print(f"\n{funcoes.mostrar_linha()}")

            id_rmv = input(
                "Selecione o Id do item ou -1 para retornar ao menu: "
            )

            try:
                id_rmv = int(id_rmv)
            except ValueError:
                input("ID inválido! Pressione Enter para tentar novamente...")
                continue

            if id_rmv == -1:
                menu()
                break

            if id_rmv not in ids_validos:
                print(f"ID {id_rmv} não encontrado no estoque.")
                input("Pressione Enter para tentar novamente...")
                continue

            nome_produto = estoque.loc[estoque["Id"] == id_rmv, "Nome"].values[0]

            while True:
                print(f"\n-> Produto Selecionado: {nome_produto}")
                remove = input(
                    "Digite a quantidade a ser removida ou -1 para retornar: "
                )
                try:
                    remove = int(remove)
                except ValueError:
                    print("Por favor, digite um número válido.")
                    continue

                if remove == -1:
                    break

                if remove <= 0:
                    print("A quantidade deve ser maior que zero!")
                    continue

                qtd_atual = estoque.loc[estoque["Id"] == id_rmv, "Quantidade"].values[0]

                # Regra de negócio: Impede que o estoque fique negativo
                if qtd_atual - remove < 0:
                    print(f"Saldo insuficiente! Estoque atual de '{nome_produto}' é apenas {qtd_atual} unidades.")
                    continue

                nova_qtd = qtd_atual - remove
                sql = text(
                    "UPDATE Produtos SET Quantidade = :nova_qtd WHERE Id = :id_rmv"
                )
                valores = {"nova_qtd": nova_qtd, "id_rmv": id_rmv}

                with engine.begin() as conexao:
                    conexao.execute(sql, valores)

                atualizar_estoque_memoria()

                print(f"\nSucesso! {remove} unidades removidas de '{nome_produto}'.")
                input("Pressione Enter para continuar...")
                break
    
    # ----------------------------------------
    # OPÇÃO 3: CADASTRAR UM PRODUTO TOTALMENTE NOVO
    # ----------------------------------------
    elif pag1 == 3:
        salvou = False  # Flag (sinalizador) para interromper os múltiplos loops encadeados ao finalizar o cadastro
        while True:
            limpar_tela()
            print(f"--- CADASTRAR NOVO PRODUTO ---\n")
            nome = input('Digite o nome do item ou -1 para retornar: ').strip()
            
            if nome == '-1':
                menu()
                break
            if not nome:
                print("O nome não pode ficar em branco!")
                input("Pressione Enter para tentar novamente...")
                continue
                
            # Loop para a inserção e validação do preço
            while True:
                preco = input('Digite o preço ou -1 para retornar: ').strip()
                if preco == '-1':
                    break
                try:
                    # Permite que o usuário digite vírgula substituindo-a por ponto (padrão do Python)
                    preco = float(preco.replace(',', '.'))
                except ValueError:
                    print("Digite apenas números e use ponto para centavos (Ex: 12.50).")
                    input("Aperte Enter para tentar novamente... ")
                    continue
                
                # Mapeia e extrai as categorias únicas existentes no estoque atual para o usuário escolher
                categorias = pd.Series(estoque['Categoria'].unique())
                
                # Loop para seleção da categoria do produto
                while True:
                    limpar_tela()
                    print("--- CATEGORIAS DISPONÍVEIS ---")
                    print(categorias.to_string(index=True))  # Exibe a lista de categorias com um índice (0, 1, 2...)
                    print(funcoes.mostrar_linha())
                    
                    id_categoria = input('Selecione a categoria do produto ou -1 pra retornar: ').strip()
                    if id_categoria == '-1':
                        break
                    if not id_categoria:
                        print("A categoria não pode ficar em branco!")
                        input("Pressione Enter para tentar novamente...")
                        continue
                        
                    try:
                        id_categoria = int(id_categoria)
                        # Garante que o índice selecionado está dentro dos limites da lista de categorias
                        if id_categoria < 0 or id_categoria >= len(categorias):
                            print("Número de categoria inválido!")
                            input("Pressione Enter para tentar novamente...")
                            continue
                    except ValueError:
                        print("Por favor, digite um número válido.")
                        input("Pressione Enter para continuar...")
                        continue

                    # Resgata o nome textual da categoria escolhida pelo índice
                    categoria = categorias.iloc[id_categoria]
                    
                    # Loop para inserção da quantidade inicial do novo produto
                    while True:
                        limpar_tela()
                        print(f'CATEGORIA ESCOLHIDA: {categoria}\n')
                        quantidade = input('Digite a quantidade ou -1 para retornar: ').strip()
                        if quantidade == '-1':
                            break
                        try:
                            quantidade = int(quantidade)
                        except ValueError:
                            print('Quantidade inválida!')
                            input('Pressione Enter para tentar novamente...')
                            continue
                        if quantidade < 0:
                            print('A quantidade deve ser igual ou superior a 0!')
                            input('Pressione Enter para tentar novamente...')
                            continue
                        
                        # TELA DE CONFIRMAÇÃO: Exibe um resumo de tudo que foi coletado antes de salvar
                        limpar_tela()
                        print(f"""--- CONFIRMAÇÃO DOS DADOS ---
PRODUTO:   {nome}
PREÇO:     R$ {preco:.2f}
CATEGORIA: {categoria}
VOLUME:    {quantidade}
{funcoes.mostrar_linha()}
[1] Confirmar e Salvar no Sistema
[2] Cancelar e Voltar
{funcoes.mostrar_linha()}""")
                        
                        opcao_final = input("Selecione a opção desejada: ").strip()
                        
                        # Opção 1: Grava os dados definitivamente no banco de dados
                        if opcao_final == "1":
                            sql_insert = text("""
                                INSERT INTO Produtos (Nome, Preco, Categoria, Quantidade)
                                VALUES (:nome, :preco, :categoria, :quantidade)
                            """)
                            
                            valores_insert = {
                                "nome": nome,
                                "preco": preco,
                                "categoria": categoria,
                                "quantidade": quantidade
                            }
                            
                            with engine.begin() as conexao:
                                conexao.execute(sql_insert, valores_insert)
                            
                            # Sincroniza a memória local com a nova inserção
                            atualizar_estoque_memoria()
                            
                            print("\n✔ Produto adicionado com sucesso!")
                            input("Pressione Enter para voltar ao menu principal...")
                            salvou = True  # Ativa a flag para quebrar as estruturas de repetição superiores
                            break
                            
                        # Opção 2: Aborta a operação atual
                        elif opcao_final == "2":
                            print("\n❌ Cadastro cancelado pelo usuário.")
                            input("Pressione Enter para voltar...")
                            salvou = True  # Ativa a flag para retornar diretamente ao menu principal
                            break
                        else:
                            print("Opção inválida!")
                            input("Pressione Enter para tentar novamente...")
                            continue
                    
                    if salvou: break  # Quebra o loop da Quantidade
                if salvou: break      # Quebra o loop da Categoria
            if salvou: 
                menu()                # Redesenha o menu inicial e limpa a tela
                break                 # Quebra o loop do Nome do produto
                
    # ----------------------------------------
    # OPÇÃO 4: FINALIZAR APLICAÇÃO
    # ----------------------------------------
    elif pag1 == 4:
        print('Saindo do programa...')
        break  # Interrompe o loop principal 'while True', fechando o programa
        
    # Tratamento para opções numéricas inválidas digitadas no menu principal
    else:
        print("Opção inválida!")
        input("Pressione Enter para tentar novamente...")
        menu()
